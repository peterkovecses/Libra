@Host = https://localhost:7109

### Get books - first page
GET {{Host}}/api/books?pageNumber=1&pageSize=10
Accept: application/json

### Get books - invalid page number (zero)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=0&pageSize=10
Accept: application/json

### Get books - invalid page number (negative)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=-1&pageSize=10
Accept: application/json

### Get books - invalid page size (zero)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=1&pageSize=0
Accept: application/json

### Get books - invalid page size (exceeds maximum)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=1&pageSize=101
Accept: application/json

### Get books - invalid page number and page size (both invalid)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=0&pageSize=101
Accept: application/json

### Get book by ID - valid ID
GET {{Host}}/api/books/1
Accept: application/json

### Get book by ID - non-existing ID
GET {{Host}}/api/books/999
Accept: application/json

### Get book by ID - non-integer ID (model binding error)
# Expected: 400 Bad Request
GET {{Host}}/api/books/aaa
Accept: application/json

### Get book by ID - zero ID (validation error)
# Expected: 400 Bad Request
GET {{Host}}/api/books/0
Accept: application/json

### Get book by ID - negative ID (validation error)
# Expected: 400 Bad Request
GET {{Host}}/api/books/-1
Accept: application/json