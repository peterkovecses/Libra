@Host = https://localhost:7109

### Get books - first page
GET {{Host}}/api/books?pageNumber=1&pageSize=10
Accept: application/json

### Search title or author and sort by title descending
GET {{Host}}/api/books?pageNumber=1&pageSize=10&search=orwell&sortBy=title&sortDirection=desc
Accept: application/json

### Get books - invalid page number (zero)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=0&pageSize=10
Accept: application/json

### Get books - invalid page number (negative)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=-1&pageSize=10
Accept: application/json

### Get books - invalid page size (zero)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=1&pageSize=0
Accept: application/json

### Get books - invalid page size (exceeds maximum)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=1&pageSize=101
Accept: application/json

### Get books - invalid page number and page size (both invalid)
# Expected: 400 Bad Request
GET {{Host}}/api/books?pageNumber=0&pageSize=101
Accept: application/json

### Get book by ID - valid ID
GET {{Host}}/api/books/1
Accept: application/json

### Get book by ID - non-existing ID
GET {{Host}}/api/books/999
Accept: application/json

### Get book by ID - non-integer ID (model binding error)
# Expected: 400 Bad Request
GET {{Host}}/api/books/aaa
Accept: application/json

### Get book by ID - zero ID (validation error)
# Expected: 400 Bad Request
GET {{Host}}/api/books/0
Accept: application/json

### Get book by ID - negative ID (validation error)
# Expected: 400 Bad Request
GET {{Host}}/api/books/-1
Accept: application/json

### Update examples
# These requests modify book 1. Run the initial GET, then set @Version to its
# string version. Run the successful PUT once, then set @NewVersion to the
# version in its response. The defaults below work on a fresh database.
# Use the OLD @Version for the 409 example and @NewVersion for the others.
@Version = 1
@NewVersion = 2

### 1. Read the current book and copy its version into @Version above
GET {{Host}}/api/books/1
Accept: application/json

### 2. List authors (increase pageNumber to inspect additional pages)
GET {{Host}}/api/authors?pageNumber=1&pageSize=100
Accept: application/json

### 3. Successful update: copy the returned version into @NewVersion
PUT {{Host}}/api/books/1
Content-Type: application/json
Accept: application/json

{
  "title": "1984 - edited",
  "authorIds": [1, 2],
  "version": "{{Version}}"
}

### 4. Stale version: 409 Conflict; book remains unchanged
PUT {{Host}}/api/books/1
Content-Type: application/json

{
  "title": "Stale edit",
  "authorIds": [1],
  "version": "{{Version}}"
}

### 5. Unknown book: 404 Not Found
PUT {{Host}}/api/books/2147483647
Content-Type: application/json

{
  "title": "Missing book",
  "authorIds": [],
  "version": "{{NewVersion}}"
}

### 6. Unknown author: 400 validation problem; title, links and version roll back
PUT {{Host}}/api/books/1
Content-Type: application/json

{
  "title": "Must not be saved",
  "authorIds": [1, 2147483647],
  "version": "{{NewVersion}}"
}

### 7. Invalid fields: 400 validation problem
PUT {{Host}}/api/books/1
Content-Type: application/json

{
  "title": " ",
  "authorIds": [0, 0],
  "version": "not-a-version"
}

### 8. Invalid JSON type: 400 problem
PUT {{Host}}/api/books/1
Content-Type: application/json

{
  "title": "Invalid payload",
  "authorIds": "not-an-array",
  "version": "{{NewVersion}}"
}

### 9. Invalid book ID: 400 validation problem
PUT {{Host}}/api/books/0
Content-Type: application/json

{
  "title": "Invalid ID",
  "authorIds": [],
  "version": "{{NewVersion}}"
}

### 10. Verify the last successful representation and its unchanged version
GET {{Host}}/api/books/1
Accept: application/json